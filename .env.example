# ─────────────────────────────────────────────────────────────
#  Copiar a .env y completar. NUNCA subir .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Dominio del sistema (Caddy obtiene el certificado HTTPS solo).
# En local usar: localhost
APP_DOMAIN=app.mecanicasanchez.com
ACME_EMAIL=tecnicentrols79@gmail.com

# Base de datos
POSTGRES_DB=taller
POSTGRES_USER=taller
POSTGRES_PASSWORD=cambia-esta-clave-larga

# API
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=12h
TZ=America/Guayaquil

# Usuario inicial (lo crea el seed; cambiar la clave al primer ingreso)
SEED_ADMIN_USER=luis
SEED_ADMIN_PASSWORD=cambia-esta-clave
# Último número del talonario en papel + 1 (la primera orden digital sigue la numeración)
NUMERO_ORDEN_INICIAL=766

# Respaldos
BACKUP_CRON=0 3 * * *
# Remoto de rclone (tipo "crypt" sobre Cloudflare R2), definido en infra/backup/rclone.conf
BACKUP_REMOTE=r2crypt:taller-backups
