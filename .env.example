# ─────────────────────────────────────────────────────────────
#  Copiar a .env y completar. NUNCA subir .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Dominio del sistema (Caddy obtiene el certificado HTTPS solo).
# En local usar: localhost
APP_DOMAIN=app.tecnicentrosanchez.com
ACME_EMAIL=tecnicentrols79@gmail.com

# Base de datos
POSTGRES_DB=taller
POSTGRES_USER=taller
POSTGRES_PASSWORD=cambia-esta-clave-larga

# API
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=12h
TZ=America/Guayaquil

# Usuarios: no hay usuario fijo. La cuenta del dueño se crea en el servidor con
#   docker compose exec api node prisma/crear-dueno.js
# y desde "Usuarios" el dueño crea las cuentas de recepción y mecánicos.
# Último número del talonario en papel + 1 (la primera orden digital sigue la numeración)
NUMERO_ORDEN_INICIAL=766

# Imágenes que publica GitHub Actions (no cambiar salvo que se mueva el repo). TAG lo pone el despliegue.
IMAGENES=ghcr.io/diegosteven/tallerquito

# Deploy hook de Cloudflare Pages (Pages → Settings → Builds → Deploy hooks): reconstruye la landing
# cuando se guarda algo en "Mantenimiento web". Vacío = no se avisa.
LANDING_DEPLOY_HOOK=

# Dirección de la landing pública (para el botón "Ver landing" del panel)
LANDING_URL=https://tecnicentrosanchez.com

# Dominios de la landing pública que pueden leer la API (separados por coma)
CORS_ORIGENES=https://tecnicentrosanchez.com,https://www.tecnicentrosanchez.com

# Respaldos
# Cada 6 horas (00:00, 06:00, 12:00, 18:00): como máximo se pierden 6 h de trabajo
BACKUP_CRON=0 */6 * * *
# Carpeta de respaldos en el VPS. La PC del taller la descarga por SFTP con el usuario "respaldos"
# (solo lectura; se crea con infra/servidor-respaldos.sh). En desarrollo se puede dejar ./backups
BACKUP_DIR=/srv/respaldos/datos
