// Modelo de datos — Fase 1: historial de mantenimiento.
// Documentación: docs/Propuesta_Sistema_Historial_Taller.pdf (sección 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  DUENO
  RECEPCION
  MECANICO
}

enum TipoItem {
  MANO_OBRA
  REPUESTO
}

enum EstadoOrden {
  ABIERTA
  CERRADA
  ANULADA
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  usuario       String   @unique
  passwordHash  String
  rol           Rol      @default(RECEPCION)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  ordenesComoMecanico OrdenTrabajo[] @relation("Mecanico")
  ordenesCreadas      OrdenTrabajo[] @relation("CreadoPor")

  @@map("usuarios")
}

model Cliente {
  id            Int      @id @default(autoincrement())
  nombre        String
  cedulaRuc     String?  @unique
  telefono      String?
  email         String?
  direccion     String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  vehiculos Vehiculo[]

  @@index([nombre])
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "clientes_nombre_trgm_idx")
  @@map("clientes")
}

model Vehiculo {
  id            Int      @id @default(autoincrement())
  placa         String   @unique
  marca         String?
  modelo        String?
  anio          Int?
  motor         String?
  /// Cilindraje tal como lo escribe el taller: "1.6", "2500 cc"…
  cilindraje    String?
  /// Número de chasis (VIN)
  vin           String?
  color         String?
  kmActual      Int?
  clienteId     Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  cliente Cliente        @relation(fields: [clienteId], references: [id])
  ordenes OrdenTrabajo[]

  @@index([clienteId])
  @@index([placa(ops: raw("gin_trgm_ops"))], type: Gin, map: "vehiculos_placa_trgm_idx")
  @@map("vehiculos")
}

/// Catálogo: cada tipo de trabajo con su intervalo recomendado.
model TipoServicio {
  id             Int     @id @default(autoincrement())
  nombre         String  @unique
  categoria      String?
  intervaloKm    Int?
  intervaloMeses Int?
  activo         Boolean @default(true)

  items OrdenItem[]

  @@map("tipos_servicio")
}

model OrdenTrabajo {
  id            Int         @id @default(autoincrement())
  numero        Int         @unique @default(autoincrement())
  vehiculoId    Int
  mecanicoId    Int?
  creadoPorId   Int?
  fecha         DateTime    @db.Date
  kilometraje   Int
  motivo        String?
  observaciones String?
  total         Decimal     @default(0) @db.Decimal(10, 2)
  /// ABIERTA: el carro está en el taller. CERRADA: entregado. Las importadas de papel entran CERRADAS.
  estado        EstadoOrden @default(CERRADA)

  // Hitos (fecha y hora), como en el talonario
  fechaLlegada          DateTime?
  fechaPedidoRepuestos  DateTime?
  fechaLlegadaRepuestos DateTime?
  fechaEntrega          DateTime?

  // Recepción del vehículo
  /// Nivel de combustible en octavos (0 = vacío, 8 = lleno)
  combustible Int?
  /// Checklist SÍ/NO: { "matricula": true, "gata": false, … } (claves en @taller/shared)
  recepcion   Json?
  /// AUTO | CAMIONETA: qué dibujo se usa para marcar golpes
  carroceria  String?
  /// Marcas sobre el dibujo: [{ vista, x, y, tipo, nota }]
  danios      Json?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  vehiculo  Vehiculo    @relation(fields: [vehiculoId], references: [id])
  mecanico  Usuario?    @relation("Mecanico", fields: [mecanicoId], references: [id])
  creadoPor Usuario?    @relation("CreadoPor", fields: [creadoPorId], references: [id])
  items     OrdenItem[]

  @@index([vehiculoId, fecha])
  @@index([fecha])
  @@map("ordenes_trabajo")
}

model OrdenItem {
  id             Int      @id @default(autoincrement())
  ordenId        Int
  tipoServicioId Int?
  tipo           TipoItem
  descripcion    String
  cantidad       Decimal  @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal  @default(0) @db.Decimal(10, 2)

  orden        OrdenTrabajo  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  tipoServicio TipoServicio? @relation(fields: [tipoServicioId], references: [id])

  @@index([tipoServicioId])
  @@map("orden_items")
}

/// Contenido editable de la landing pública (banners, servicios, contacto). Una sola fila: clave "principal".
model ConfiguracionLanding {
  id            Int      @id @default(autoincrement())
  clave         String   @unique @default("principal") @db.VarChar(50)
  datos         Json
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamp(6)

  @@map("configuraciones_landing")
}
