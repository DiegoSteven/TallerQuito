---
import { CONFIGURACION_LANDING_DEFAULT, type LandingConfig } from '@taller/shared';

// Dirección de la API del taller. En local: http://localhost:3000. En producción se define al construir:
//   PUBLIC_API_URL=https://app.mecanicasanchez.com pnpm --filter @taller/landing build
const API = (import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000').replace(/\/+$/, '');

// Contenido editable desde "Mantenimiento web"; si la API no responde, se usan los datos por defecto.
let datosConfig: LandingConfig = CONFIGURACION_LANDING_DEFAULT;
try {
  const res = await fetch(`${API}/api/landing`, { signal: AbortSignal.timeout(2500) });
  if (res.ok) {
    const json = await res.json();
    if (json && json.slides) datosConfig = json;
  }
} catch {
  // En modo build estático o si la API no está en línea, usa los datos profesionales por defecto
  datosConfig = CONFIGURACION_LANDING_DEFAULT;
}

const { taller, slides, servicios, pilares } = datosConfig;
const slidesActivos = slides.filter((s) => s.activo);
const waPrincipal = `https://wa.me/${taller.whatsapp}?text=${encodeURIComponent('Hola Mecánica Sánchez, quisiera agendar un turno para mi vehículo.')}`;

/** Las fotos subidas vienen como ruta (/api/uploads/…): se les antepone el dominio de la API. */
function resolverFoto(url: string): string {
  if (!url) return '';
  return url.startsWith('/') ? `${API}${url}` : url;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: taller.nombre,
  telephone: taller.telefono,
  email: taller.email,
  slogan: taller.lema,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Oswaldo Guayasamín E3-115 y Manuel Betancourt',
    addressLocality: 'Cumbayá',
    addressRegion: 'Pichincha',
    addressCountry: 'EC',
  },
};
