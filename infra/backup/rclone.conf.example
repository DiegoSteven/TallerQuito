# Copiar a infra/backup/rclone.conf (no se sube al repo).
# Lo más fácil es generarlo con:  rclone config
#
# 1) Remoto "r2": bucket de Cloudflare R2 (plan gratis: 10 GB)
[r2]
type = s3
provider = Cloudflare
access_key_id = XXXX
secret_access_key = XXXX
endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
acl = private

# 2) Remoto "r2crypt": cifra todo antes de subirlo a "r2".
#    Guarde las contraseñas en un lugar seguro: sin ellas no se puede restaurar.
[r2crypt]
type = crypt
remote = r2:taller-backups
password = <generada por rclone config>
password2 = <generada por rclone config>
