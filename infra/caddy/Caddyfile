{
	email {$ACME_EMAIL}
}

# APP_DOMAIN=localhost en local; en producción, el dominio real (HTTPS automático).
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API (NestJS)
	handle /api/* {
		reverse_proxy api:3000
	}

	# Web (React): cualquier otra ruta devuelve index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
